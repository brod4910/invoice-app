// Copy to Config/Secrets.xcconfig and fill in. That file is git-ignored.
// Note: xcconfig treats "//" as a comment, so URLs are written with /$()/ in the middle.

APP_BUNDLE_ID = com.yourname.invoices
APP_TEAM_ID = ABCDE12345

// From Google Cloud Console > APIs & Services > Credentials > OAuth client ID (iOS)
GOOGLE_CLIENT_ID = 1234567890-abc.apps.googleusercontent.com
GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.1234567890-abc

// The deployed Cloudflare Worker from /proxy, and the APP_TOKEN secret you set on it.
EXTRACTION_PROXY_URL = https:/$()/invoice-extract.yourname.workers.dev
EXTRACTION_APP_TOKEN = paste-a-long-random-string
